[
  {
    "name": "upper_then_join",
    "fixtures": {
      "a": "hello.txt",
      "b": "world.txt"
    },
    "spec": {
      "version": 1,
      "inputs": {
        "a": "$a",
        "b": "$b"
      },
      "steps": [
        {
          "id": "up",
          "op": "debug.upper",
          "in": "a"
        },
        {
          "id": "out",
          "op": "debug.join",
          "in": [
            "up",
            "b"
          ],
          "args": {
            "sep": "-"
          }
        }
      ],
      "outputs": [
        "out"
      ]
    },
    "ops": {
      "debug.join": "1.0.0",
      "debug.upper": "1.0.0"
    },
    "outputs": {
      "out": "8ac7528d05e0d9d64cd79254005b5208fb471ead724ab3fdc7bc1bae70a585ac"
    },
    "reference_only": false
  },
