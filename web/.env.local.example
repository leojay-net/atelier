# Copy to .env.local and fill in a real key.
# Get one by running, from the repo root:
#   uv run python manage.py create_org acme "Acme Studio"
# (prints the key once; it cannot be retrieved again, only rotated with
# `uv run python manage.py create_api_key acme <name>`)

ATELIER_API_BASE=http://localhost:8000/api/v1
ATELIER_API_KEY=atk_xxxx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
